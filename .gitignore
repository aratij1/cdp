# Raw dataset (potentially sensitive claim data) - never commit
/dataset_raw/
/data/*.zip
/data/**/*
!/data/.gitkeep

# Operator-supplied template reference scans (potentially sensitive) - never commit
/config/templates/reference_images/
/reference_snapshots/
/config/reference_snapshots/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
.venv-*/
venv/
.uv-cache/
.test-tmp*/
.pytest-tmp-*/
.pytest_cache/
.pytest-work/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
evaluation_results/
.ocr-cache/
build/
dist/

# Evaluation truth, predictions, and reviewer events can contain PHI.
# Keep only the data-handling documentation in source control.
/evaluation_data/*
!/evaluation_data/README.md
# Canonical ground truth files — agent-created (no vendor PHI), safe to track.
!/evaluation_data/hackathon_agent_gt/
!/evaluation_data/hackathon_agent_gt/field_truth.json
!/evaluation_data/ground_truth.json
!/evaluation_data/document_manifest.json
!/evaluation_data/hard15_v12_3o/
!/evaluation_data/hard15_v12_3o/**
# Non-governed evaluation outputs (governed phase baselines may still be tracked
# when explicitly allowlisted by scripts/check_architecture.py).
/evaluation_results/**
!/evaluation_results/phase7a13/
!/evaluation_results/phase7a13/**
!/evaluation_results/phase7a14/
!/evaluation_results/phase7a14/**
!/evaluation_results/phase7a14b/
!/evaluation_results/phase7a14b/**
!/evaluation_results/phase8_5/
!/evaluation_results/phase8_5/**
!/evaluation_results/phase8_6/
!/evaluation_results/phase8_6/**
!/evaluation_results/phase8_7/
!/evaluation_results/phase8_7/**
!/evaluation_results/phase8_8/
!/evaluation_results/phase8_8/**

# Generated/local bundle executions and scratch reports
/runs/
/bundle_runs/
/scratchpad_reports/
/test-artifacts/pytest-*/
*.report.json
/phase8_12_replay_report.json

# Local model / HuggingFace caches
.cache/
.huggingface/
**/huggingface/
models--*/
.torch/

# Env / secrets. The broad pattern also catches accidental names such as
# `.env.local`, `.env copy`, and nested test environment files.
**/.env*
!/.env.example

# IDE
.vscode/
.idea/

# Local data volumes
deploy/docker/volumes/
*.log

# OS
.DS_Store
Thumbs.db

# Node (review UI)
node_modules/
apps/human_review_api/frontend/dist/
apps/evaluation_ui/dist/
apps/evaluation_ui/public/reports/evidence/
submission/
.pytest_tmp/
*.tsbuildinfo

# Local operator/model state
.claude/
.docker-empty/
.model-cache/
.tools/
.env

# Isolated PP-OCRv5 Server runtime
.venv-ppocrv5/
ocr_model_attempts_report.csv
